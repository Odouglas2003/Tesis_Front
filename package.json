{
  "name": "planilla-rubik",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "rimraf .next && rimraf node_modules && rimraf coverage",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "lint:quiet": "next lint --quiet",
    "lint:check": "next lint",
    "prebuild": "npm run typecheck && npm run lint:quiet",
    "start": "next start -p 3000",
    "start:prod": "next start -p 3000",
    "analyze": "ANALYZE=true next build",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production next build"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "6.1.5",
    "@mui/joy": "^5.0.0-beta.52",
    "@mui/material": "6.1.5",
    "axios": "^1.11.0",
    "framer": "^2.4.1",
    "jose": "^6.0.11",
    "jwt-decode": "^4.0.0",
    "motion": "^12.23.12",
    "next": "^15.1.9",
    "next-images": "^1.8.5",
    "nodemailer": "^7.0.11",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.56.1",
    "recharts": "^2.15.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.3.1",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.1",
    "eslint": "^8",
    "eslint-config-next": "^15.1.9",
    "eslint-plugin-unused-imports": "^4.2.0",
    "postcss": "^8",
    "react-beautiful-dnd": "^13.1.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.6.3"
  }
}
